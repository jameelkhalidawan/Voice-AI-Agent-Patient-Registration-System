APP_NAME=Care Cloud Patient Intake API
APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
# Use a local SQLite URL for development until Stage 2 hosted DB setup is complete.
DATABASE_URL=sqlite:///./care_cloud.db
# Set a long random value before using write endpoints.
API_KEY=replace-with-a-long-random-secret
# Used to authenticate Vapi server webhooks with Authorization: Bearer <secret>.
VAPI_WEBHOOK_SECRET=replace-with-a-different-long-random-secret
# Optional comma-separated browser origins; empty means same-origin only.
CORS_ORIGINS=
# Webhook payloads include end-of-call transcripts, so allow a larger bounded body.
MAX_WEBHOOK_REQUEST_BYTES=1048576
